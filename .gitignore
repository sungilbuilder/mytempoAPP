# 의존성 (401MB — 절대 커밋하지 말 것, package.json/package-lock.json만 올리면 재현됨)
node_modules/

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
*.jsbundle

# 네이티브 빌드 산출물
# 주의: 선행 슬래시는 레포 루트에만 매칭된다. 앱은 HQ/03_Output_App/ 아래 있으므로
# 슬래시 없는 패턴을 써야 어느 깊이에서든 잡힌다. (android/app/build 만 839MB)
# 이 디렉터리는 app.json 설정으로부터 `expo prebuild`가 재생성하므로 커밋 불필요.
ios/
android/
*.orig.*
*.apk
*.aab
*.ipa

# 사운드 탐색 산출물 — `scripts/signature_sound.py`가 만드는 후보 wav·오디션 파일.
# 재생성 가능하므로 커밋 대상이 아니다(스크립트 자체만 저장소에 남는다).
# 주의(2026-08-20 수정): 원래 패턴 "scripts/_sound_exploration/"은 중간에 슬래시가 있어
# 레포 루트에만 앵커링돼, 실제 위치인 HQ/03_Output_App/scripts/_sound_exploration/를
# 못 잡고 있었다(12번 줄의 같은 원리 설명 참고). 슬래시 없는 패턴으로 교체.
_sound_exploration/

# Strix 보안 스캔 실행 산출물 — 실행할 때마다 새로 생기는 로그·SARIF·에이전트 상태.
# 코드가 아니라 도구 실행 캐시라 커밋 대상이 아니다.
strix_runs/

# 로그
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# 에디터 / 에이전트 로컬 설정
.vscode/
.idea/
*.swp
.claude/settings.local.json

# 파이썬 도구 캐시 (scripts/*.py)
__pycache__/
*.py[cod]

# 환경변수 / 비밀키 (현재 없지만 실수 방지용으로 미리 차단)
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
google-services.json
GoogleService-Info.plist

# 임시 파일
*.tmp
~$*
.~lock.*#

