{
  "expo": {
    "name": "마이템포",
    "slug": "mytempo-golf",
    "scheme": "mytempo",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0D110D",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mytempo.golf",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mytempo.golf",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#436437"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D110D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "내 스윙 영상을 불러와 템포를 측정하기 위해 사진 보관함 접근이 필요합니다. 선택한 영상은 기기 안에서만 처리되며 외부로 전송되지 않습니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a119501d-688a-4eee-927f-f94070c14319"
      }
    },
    "owner": "josungil0127"
  }
}
