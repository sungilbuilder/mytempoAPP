{
  "expo": {
    "name": "마이템포",
    "slug": "mytempo-golf",
    "scheme": "mytempo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0D110D",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mytempo.golf",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.mytempo.golf",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#436437"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D110D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "내 스윙 영상을 불러와 템포를 측정하기 위해 사진 보관함 접근이 필요합니다. 선택한 영상은 기기 안에서만 처리되며 외부로 전송되지 않습니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-audio",
      "expo-video"
    ]
  }
}
